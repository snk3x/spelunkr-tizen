<?xml version="1.0" encoding="UTF-8"?>
<!-- Personal-use Tizen wrapper that opens spelunkr.tv full screen. Not affiliated with Spelunkr. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://localhost/spelunkr-wrapper" version="1.0.0" viewmodes="maximized">
    <tizen:application id="SpLnkrTV01.Spelunkr" package="SpLnkrTV01" required_version="2.3"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Spelunkr</name>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Network access for the site and the Internet Archive videos it plays -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <!-- The loaded Spelunkr page uses inline scripts and styles; allow them inside the app. -->
    <tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'</tizen:content-security-policy>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
